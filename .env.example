# Copy to .env and fill in real values. docker-compose.yml reads this file
# for the api/worker/maintenance services.
#
# REDIS_URL, DATABASE_URL, CACHE_DIR and EPUB_DIR are NOT listed here -
# docker-compose.yml wires those itself (internal service DNS + the shared
# "data" volume) and overrides anything set for them in this file.

# Auth (Supabase JWT verification)
AUTHX_SECRET_KEY=change-me-in-production
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# Email delivery (send-to-device / Kindle)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
